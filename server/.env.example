# =====================================================================
# server/.env.example
# Copy file ini jadi ".env" (tanpa .example) lalu sesuaikan nilainya.
# Untuk Laragon default: DB_USER=root, DB_PASSWORD=(kosongkan saja)
# JANGAN pernah menaruh API key / password asli di file .example ini.
# =====================================================================

PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rosita_salon

# Wajib string acak minimal 32 karakter. Bikin dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Akun admin awal, dibuat lewat "npm run seed:admin".
# Kosongkan ADMIN_PASSWORD supaya dibuatkan password acak yang kuat.
ADMIN_NAME=Admin Rosita Salon
ADMIN_EMAIL=admin@rositasalon.com
ADMIN_PASSWORD=

# URL frontend yang diizinkan mengakses API ini (untuk CORS).
# Bisa lebih dari satu, pisahkan dengan koma.
CLIENT_ORIGIN=http://localhost:5173

# Jumlah customer yang bisa dilayani bersamaan di satu slot jam (jumlah terapis)
SLOT_CAPACITY=1

# API key Google Gemini untuk AI Asisten (ambil di https://aistudio.google.com/apikey)
# Kosongkan kalau fitur AI tidak dipakai.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model cadangan (dipisah koma), dipakai kalau model utama sedang ramai
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview
